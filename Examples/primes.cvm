// primes.cvm
// Finds all prime numbers up to a specified limit
// Since CVM++ doesn't have a modulo operator (%), we check divisibility
// by doing (num / i) * i == num

let limit = 20;
let num = 2;

while (num < limit) {
    let is_prime = true;
    let i = 2;
    
    // Check all numbers up to num - 1
    while (i < num) {
        let div = num / i;
        if (div * i == num) {
            is_prime = false;
        }
        i = i + 1;
    }
    
    if (is_prime == true) {
        print num;
    }
    
    num = num + 1;
}
